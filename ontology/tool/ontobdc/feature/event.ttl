@prefix : <http://datacenter.app.br/ontology/tool/ontobdc/feature/event.ttl#> .
@prefix ewe: <http://gsi.upm.es/ontologies/ewe/ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sem: <http://semanticweb.cs.vu.nl/2009/11/sem/> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix feat: <http://datacenter.app.br/ontology/tool/ontobdc/feature/ns.ttl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sioc: <http://rdfs.org/sioc/ns#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix convo: <https://ontology.inferal.com/modules/conversation/> .
@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix co: <http://purl.org/co/> .
@base <http://datacenter.app.br/ontology/tool/ontobdc/feature/event.ttl#> .

<http://datacenter.app.br/ontology/tool/ontobdc/feature/event.ttl> rdf:type owl:Ontology ;
                                                                   owl:versionIRI <http://datacenter.app.br/ontology/tool/ontobdc/feature/event.ttl/0.1.0> .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/identifier
dcterms:identifier rdf:type owl:AnnotationProperty .


###  http://rdfs.org/sioc/ns#container_of
sioc:container_of rdf:type owl:AnnotationProperty .


###  http://rdfs.org/sioc/ns#has_parent
sioc:has_parent rdf:type owl:AnnotationProperty .


###  http://rdfs.org/sioc/ns#has_subscriber
sioc:has_subscriber rdf:type owl:AnnotationProperty .


###  http://rdfs.org/sioc/ns#subscriber_of
sioc:subscriber_of rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://gsi.upm.es/ontologies/ewe/ns#generatesEvent
ewe:generatesEvent rdf:type owl:ObjectProperty ;
                   rdfs:domain ewe:Channel ;
                   rdfs:range ewe:Event .


#################################################################
#    Classes
#################################################################

###  http://datacenter.app.br/ontology/tool/ontobdc/feature/ns.ttl#DigitalAssistantPanel
feat:DigitalAssistantPanel rdf:type owl:Class .


###  http://datacenter.app.br/ontology/tool/ontobdc/feature/ns.ttl#DigitalDock
feat:DigitalDock rdf:type owl:Class .


###  http://datacenter.app.br/ontology/tool/ontobdc/feature/ns.ttl#OntoAssistant
feat:OntoAssistant rdf:type owl:Class .


###  http://datacenter.app.br/ontology/tool/ontobdc/feature/ns.ttl#PresentationEvent
feat:PresentationEvent rdf:type owl:Class .


###  http://gsi.upm.es/ontologies/ewe/ns#Channel
ewe:Channel rdf:type owl:Class .


###  http://gsi.upm.es/ontologies/ewe/ns#Event
ewe:Event rdf:type owl:Class .


###  http://rdfs.org/sioc/ns#Container
sioc:Container rdf:type owl:Class .


###  http://rdfs.org/sioc/ns#UserAccount
sioc:UserAccount rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://datacenter.app.br/ontology/tool/ontobdc/feature/event.ttl#AIAssistantPanel
:AIAssistantPanel rdf:type owl:NamedIndividual ,
                            feat:DigitalAssistantPanel ;
                   sioc:container_of :AssistantTab .


###  http://datacenter.app.br/ontology/tool/ontobdc/feature/event.ttl#AssistantTab
:AssistantTab rdf:type owl:NamedIndividual ,
                       feat:OntoAssistant ,
                       sioc:UserAccount ;
              sioc:has_parent :AIAssistantPanel ;
              sioc:subscriber_of :LayoutLoadedEvent .


###  http://datacenter.app.br/ontology/tool/ontobdc/feature/event.ttl#DigitalDockPresentation
:DigitalDockPresentation rdf:type owl:NamedIndividual ,
                                  feat:DigitalDock ;
                         ewe:generatesEvent :LayoutLoadedEvent .


###  http://datacenter.app.br/ontology/tool/ontobdc/feature/event.ttl#LayoutLoadedEvent
:LayoutLoadedEvent rdf:type owl:NamedIndividual ,
                            feat:PresentationEvent ,
                            sioc:Container ;
                   dcterms:identifier "presentation.main.layout.loaded" ;
                   sioc:has_subscriber :AssistantTab .


:NoProjectLoaded a dul:Description .

:Desktop a dul:Concept .

:Mobile a dul:Concept .

:Browser a dul:Concept .

:NativeApp a dul:Concept .

:InitialDesktopBrowserPresentationContext a dul:Situation ;
    dul:satisfies :NoProjectLoaded ;
    dul:isClassifiedBy :Desktop , :Browser ;
    dul:isSettingFor :DesktopWelcomeConversation .

:InitialMobileBrowserPresentationContext a dul:Situation ;
    dul:satisfies :NoProjectLoaded ;
    dul:isClassifiedBy :Mobile , :Browser ;
    dul:isSettingFor :MobileWelcomeConversation .

:DesktopWelcomeConversation a convo:Conversation, co:List;
    co:firstItem :DesktopWelcomeMessage;
    dul:hasSetting :InitialDesktopBrowserPresentationContext .

:MobileWelcomeConversation a convo:Conversation, co:List ;
   co:firstItem :MobileWelcomeMessage; dul:hasSetting :InitialMobileBrowserPresentationContext .

:DesktopWelcomeMessage a co:ListItem, convo:Message ;
    convo:inThread :OnLayoutLoaded ;
    convo:contributionOf :DesktopWelcomeConversation ;
    convo:authoredBy :AssistantTab ;
    convo:text "Seja bem-vindo ao InfoBIM! Você ainda não tem um projeto aberto. Selecione uma das opções abaixo para começar."@pt-BR ,
               "Welcome to InfoBIM! You don't have a project open yet. Select one of the options below to get started."@en ,
               "¡Bienvenido a InfoBIM! Todavía no tienes ningún proyecto abierto. Selecciona una de las opciones a continuación para comenzar."@es .

:MobileWelcomeMessage a co:ListItem, convo:Message ;
    convo:inThread :OnLayoutLoaded ;
    convo:contributionOf :MobileWelcomeConversation ;
    convo:authoredBy :AssistantTab ;
    convo:text "Seja bem-vindo ao InfoBIM! Você ainda não tem um projeto aberto. Conecte-se a um projeto remoto para começar."@pt-BR ,
               "Welcome to InfoBIM! You don't have a project open yet. Connect to a remote project to get started."@en ,
               "¡Bienvenido a InfoBIM! Todavía no tienes ningún proyecto abierto. Conéctate a un proyecto remoto para comenzar."@es .

:OnLayoutLoaded a ewe:Rule, convo:Thread;
    ewe:triggeredBy :LayoutLoadedEvent ;
    ewe:uses :DigitalDockPresentation ;
    dul:associatedWith :InitialDesktopBrowserPresentationContext ,
                       :InitialMobileBrowserPresentationContext .


