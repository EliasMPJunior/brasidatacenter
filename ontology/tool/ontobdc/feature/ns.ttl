@prefix : <http://datacenter.app.br/ontology/tool/ontobdc/feature/ns.ttl#> .
@prefix ewe: <http://gsi.upm.es/ontologies/ewe/ns#> .
@prefix sem: <http://semanticweb.cs.vu.nl/2009/11/sem/> .
@prefix sioc: <http://rdfs.org/sioc/ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

:PresentationEvent a owl:Class ;
    rdfs:subClassOf ewe:Event, sem:Event.

:DigitalDock a owl:Class ;
    rdfs:subClassOf ewe:Channel, sem:Actor .

:OntoAssistant a owl:Class ;
    rdfs:subClassOf ewe:Channel, sem:Actor .

:DigitalAssistantPanel a owl:Class ;
    rdfs:subClassOf sioc:Container. 
